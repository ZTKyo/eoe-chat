PRIMARY_PROVIDER=glm
PRIMARY_MODEL=glm-4.7

VISION_PROVIDER=glm-vision
VISION_MODEL=glm-4.6v

FALLBACK_PROVIDER=deepseek
FALLBACK_MODEL=deepseek-v4-flash

GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Development and automated tests work without real keys.
USE_MOCK_PROVIDER=true
PROVIDER_TIMEOUT_MS=30000

# Hosted production is fail-closed. To use real providers, configure these
# values in the hosting platform rather than committing them:
# EOE_EXECUTION_MODE=production
# EOE_ALLOW_LIVE_PROVIDER=true
# USE_MOCK_PROVIDER=false
EOE_ALLOW_LIVE_PROVIDER=false

# Optional single-user hosted Beta protection. Leave blank for local
# development. Use a 32+ character random session secret in production.
EOE_ACCESS_PASSWORD=
EOE_ACCESS_SESSION_SECRET=

# 0 disables the signed-cookie quota locally. The hosted private Beta uses 50.
EOE_DAILY_REQUEST_LIMIT=0

# English Overlay Engine Alpha (M2 uses a fixed long-term level).
EOE_ENABLED=true
EOE_FIXED_LEVEL=2
EOE_DEVELOPER_MODE=false

# Text-First Beta keeps image input off. Vision code remains available only
# when this flag is true and Developer Mode is explicitly enabled.
EOE_ENABLE_IMAGE_INPUT=false
